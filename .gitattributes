# Files that exist in the repository but must not ship in the release zip.
# The zip is built with `git archive` (release.yml), so only tracked, non-ignored files can ever
# land in it. The release-zip job in ci.yml asserts the result.
.github/        export-ignore
.s2s/           export-ignore
.claude/        export-ignore
.superpowers/   export-ignore
docker*/        export-ignore
spike/          export-ignore
CTX-MEMORY.md   export-ignore
*.local.md      export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.moodle-plugin-ci.yml export-ignore
cli/            export-ignore
